# Renders a theme attrset (see ../../../themes) as a Lua module.
#
# The result is written to ~/.config/nvim/lua/theme.lua, which
# colors/dotfiles.lua and the lualine spec `require` - so neovim and the rest
# of the desktop always read the same palette.
{ lib, theme }:
let
    # Lua only allows bare `key =` for identifiers; everything else needs ["key"].
    renderKey =
        name:
        if builtins.match "[A-Za-z_][A-Za-z0-9_]*" name != null then name else ''["${name}"]'';

    renderValue =
        indent: value:
        if builtins.isAttrs value then
            renderSet indent value
        else if builtins.isList value then
            renderList indent value
        else if builtins.isBool value then
            (if value then "true" else "false")
        else if builtins.isInt value || builtins.isFloat value then
            toString value
        else
            ''"${toString value}"'';

    renderSet =
        indent: set:
        let
            inner = indent + "    ";
            entries = lib.mapAttrsToList (
                name: value: "${inner}${renderKey name} = ${renderValue inner value},"
            ) set;
        in
        "{\n" + lib.concatStringsSep "\n" entries + "\n${indent}}";

    renderList =
        indent: list:
        let
            inner = indent + "    ";
            entries = map (value: "${inner}${renderValue inner value},") list;
        in
        "{\n" + lib.concatStringsSep "\n" entries + "\n${indent}}";
in
''
-- Generated by Nix from vars.theme - do not edit.
-- Change the theme in vars.nix / themes/*.nix and rebuild instead.

return ${renderValue "" theme}
''
